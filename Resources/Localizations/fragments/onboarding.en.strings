/* Onboarding + permission status. Tone: calm, plain-language, never scolding.
   Deliberately avoids the internal vocabulary (green/gray/red zone) until it is defined here. */

"onboarding.window_title" = "Welcome to Anchor";

"onboarding.welcome.title" = "A lookout, not a jailer";
"onboarding.welcome.subtitle" = "Anchor never blocks anything. When you drift away from what you were doing, it lights up a countdown and gently fogs the screen — one click brings you back.";
"onboarding.zone.green.title" = "Working — the “green zone”";
"onboarding.zone.green.detail" = "Apps and sites you marked as part of the task. Anchor stays invisible — just a quiet green dot.";
"onboarding.zone.gray.title" = "Drifting — the “gray zone”";
"onboarding.zone.gray.detail" = "Anything unclassified. A countdown starts. You are not blocked — the screen just fogs a little more the longer you stay.";
"onboarding.zone.red.title" = "Off-limits — the “red zone”";
"onboarding.zone.red.detail" = "Sites you explicitly ruled out. Anchor speaks up right away — but still waits 5 seconds, in case you clicked by mistake.";
"onboarding.welcome.escape_hatch" = "Whenever you actually want a break, hold the island for 3 seconds — that is a sanctioned 5 minutes, no guilt, no argument.";

"onboarding.scene.title" = "Pick what you are doing";
"onboarding.scene.subtitle" = "A scene decides which apps count as work. You can change it any time from the menu bar.";
"onboarding.scene.observe_only" = "Records only — never fogs the screen";
"onboarding.scene.rule_count" = "%1$lld working · %2$lld off-limits";
"onboarding.scene.footnote" = "Anchor only nudges you once it knows somewhere to bring you back to. Until then it just watches quietly.";

